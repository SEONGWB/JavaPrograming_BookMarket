{{>layout/header}}

<main class="bg-slate-50 py-16">
    <section class="mx-auto max-w-5xl px-6">
        <div class="mb-8">
            <a href="/books" class="mb-5 inline-flex items-center gap-2 text-sm font-semibold text-slate-500 hover:text-slate-900">
                <i data-lucide="arrow-left" class="h-4 w-4"></i>
                도서 목록으로
            </a>
            <p class="mb-2 text-sm font-bold uppercase tracking-[0.2em] text-emerald-700">New Book</p>
            <h1 class="text-4xl font-extrabold tracking-tight text-[#0B1E40]">도서 등록</h1>
        </div>

        <div class="grid grid-cols-1 gap-8 lg:grid-cols-[320px_1fr]">
            <aside class="h-fit rounded-2xl border border-gray-100 bg-white p-5 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.06)]">
                <div class="aspect-[4/3] overflow-hidden rounded-xl bg-slate-100">
                    <img id="imagePreview" alt="도서 이미지 미리보기" class="hidden h-full w-full object-cover">
                    <div id="imageEmpty" class="flex h-full w-full items-center justify-center text-slate-300">
                        <i data-lucide="book-image" class="h-16 w-16 stroke-[1.2]"></i>
                    </div>
                </div>
                <p class="mt-4 text-sm leading-relaxed text-slate-500">이미지 URL을 입력하거나 파일을 선택하면 표지 이미지가 함께 저장됩니다.</p>
            </aside>

            <div class="rounded-2xl border border-gray-100 bg-white p-8 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.06)]">
                <form class="grid grid-cols-1 gap-6 md:grid-cols-2">
                    <label class="block">
                        <span class="mb-2 block text-sm font-semibold text-slate-700">ISBN</span>
                        <input type="text" id="isbn" class="w-full rounded-lg border border-gray-200 px-4 py-3 outline-none transition focus:border-[#0B1E40] focus:ring-4 focus:ring-slate-100" placeholder="ISBN을 입력하세요">
                    </label>
                    <label class="block">
                        <span class="mb-2 block text-sm font-semibold text-slate-700">도서명</span>
                        <input type="text" id="title" class="w-full rounded-lg border border-gray-200 px-4 py-3 outline-none transition focus:border-[#0B1E40] focus:ring-4 focus:ring-slate-100" placeholder="도서명을 입력하세요">
                    </label>
                    <label class="block">
                        <span class="mb-2 block text-sm font-semibold text-slate-700">저자</span>
                        <input type="text" id="author" class="w-full rounded-lg border border-gray-200 px-4 py-3 outline-none transition focus:border-[#0B1E40] focus:ring-4 focus:ring-slate-100" placeholder="저자를 입력하세요">
                    </label>
                    <label class="block">
                        <span class="mb-2 block text-sm font-semibold text-slate-700">출판사</span>
                        <input type="text" id="publisher" class="w-full rounded-lg border border-gray-200 px-4 py-3 outline-none transition focus:border-[#0B1E40] focus:ring-4 focus:ring-slate-100" placeholder="출판사를 입력하세요">
                    </label>
                    <label class="block">
                        <span class="mb-2 block text-sm font-semibold text-slate-700">판매가</span>
                        <input type="number" id="price" class="w-full rounded-lg border border-gray-200 px-4 py-3 outline-none transition focus:border-[#0B1E40] focus:ring-4 focus:ring-slate-100" placeholder="판매가를 입력하세요">
                    </label>
                    <label class="block">
                        <span class="mb-2 block text-sm font-semibold text-slate-700">분류</span>
                        <input type="text" id="category" class="w-full rounded-lg border border-gray-200 px-4 py-3 outline-none transition focus:border-[#0B1E40] focus:ring-4 focus:ring-slate-100" placeholder="예: 프로그래밍, 에세이">
                    </label>
                    <label class="block">
                        <span class="mb-2 block text-sm font-semibold text-slate-700">출간일</span>
                        <input type="date" id="releaseDate" class="w-full rounded-lg border border-gray-200 px-4 py-3 outline-none transition focus:border-[#0B1E40] focus:ring-4 focus:ring-slate-100">
                    </label>
                    <label class="block">
                        <span class="mb-2 block text-sm font-semibold text-slate-700">이미지 파일</span>
                        <input type="file" id="imageFile" accept="image/*" class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none transition file:mr-4 file:rounded-md file:border-0 file:bg-slate-900 file:px-3 file:py-2 file:font-semibold file:text-white focus:border-[#0B1E40] focus:ring-4 focus:ring-slate-100">
                    </label>
                    <label class="block md:col-span-2">
                        <span class="mb-2 block text-sm font-semibold text-slate-700">이미지 URL</span>
                        <input type="text" id="imageUrl" class="w-full rounded-lg border border-gray-200 px-4 py-3 outline-none transition focus:border-[#0B1E40] focus:ring-4 focus:ring-slate-100" placeholder="https://example.com/book-cover.jpg">
                    </label>
                    <label class="block md:col-span-2">
                        <span class="mb-2 block text-sm font-semibold text-slate-700">설명</span>
                        <textarea id="description" rows="5" class="w-full rounded-lg border border-gray-200 px-4 py-3 outline-none transition focus:border-[#0B1E40] focus:ring-4 focus:ring-slate-100" placeholder="도서 소개를 입력하세요"></textarea>
                    </label>
                </form>

                <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-end">
                    <a href="/books" class="inline-flex items-center justify-center rounded-lg border border-gray-200 px-6 py-3 font-semibold text-slate-600 transition-colors hover:bg-slate-50">취소</a>
                    <button type="button" id="btn-save" class="inline-flex items-center justify-center gap-2 rounded-lg bg-[#0B1E40] px-6 py-3 font-semibold text-white transition-colors hover:bg-[#152e5c]">
                        <i data-lucide="save" class="h-4 w-4"></i>
                        등록
                    </button>
                </div>
            </div>
        </div>
    </section>
</main>

{{>layout/footer}}
