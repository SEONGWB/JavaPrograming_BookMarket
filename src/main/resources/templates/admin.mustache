{{>layout/header}}

<main class="bg-slate-50 py-16">
    <section class="mx-auto max-w-7xl px-6">
        <div class="mb-8 flex flex-col justify-between gap-4 md:flex-row md:items-end">
            <div>
                <p class="mb-2 text-sm font-bold uppercase tracking-[0.2em] text-emerald-700">Admin</p>
                <h1 class="text-4xl font-extrabold tracking-tight text-[#0B1E40]">관리자 페이지</h1>
                <p class="mt-3 text-sm text-slate-500">회원, 도서, 주문 현황을 한 곳에서 확인합니다.</p>
            </div>
            <a href="/book/save" class="inline-flex items-center justify-center gap-2 rounded-lg bg-[#0B1E40] px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-[#152e5c]">
                <i data-lucide="plus" class="h-4 w-4"></i>
                도서 등록
            </a>
        </div>

        <div class="mb-6 grid grid-cols-1 gap-4 md:grid-cols-3">
            <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.06)]">
                <p class="text-sm font-semibold text-slate-500">회원</p>
                <strong id="adminUserCount" class="mt-2 block text-3xl font-extrabold text-[#0B1E40]">0</strong>
            </div>
            <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.06)]">
                <p class="text-sm font-semibold text-slate-500">도서</p>
                <strong id="adminBookCount" class="mt-2 block text-3xl font-extrabold text-[#0B1E40]">0</strong>
            </div>
            <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.06)]">
                <p class="text-sm font-semibold text-slate-500">주문</p>
                <strong id="adminOrderCount" class="mt-2 block text-3xl font-extrabold text-[#0B1E40]">0</strong>
            </div>
        </div>

        <div class="grid grid-cols-1 gap-6 xl:grid-cols-[1fr_1fr]">
            <section class="rounded-2xl border border-gray-100 bg-white p-6 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.06)]">
                <h2 class="mb-4 text-xl font-extrabold text-slate-900">회원 현황</h2>
                <div id="adminUsers" class="space-y-3 text-sm text-slate-600"></div>
            </section>

            <section class="rounded-2xl border border-gray-100 bg-white p-6 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.06)]">
                <h2 class="mb-4 text-xl font-extrabold text-slate-900">도서 현황</h2>
                <div id="adminBooks" class="space-y-3 text-sm text-slate-600"></div>
            </section>

            <section class="rounded-2xl border border-gray-100 bg-white p-6 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.06)] xl:col-span-2">
                <h2 class="mb-4 text-xl font-extrabold text-slate-900">주문 현황</h2>
                <div id="adminOrders" class="space-y-3 text-sm text-slate-600"></div>
            </section>
        </div>
    </section>
</main>

{{>layout/footer}}
