{{>layout/header}}

<main class="bg-slate-50 py-16">
    <section class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-6 lg:grid-cols-[1fr_440px] lg:items-center">
        <div>
            <p class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-emerald-700">Signup</p>
            <h1 class="mb-5 text-5xl font-extrabold leading-tight tracking-tight text-[#0B1E40]">새 계정으로<br/>북마켓 시작하기</h1>
            <p class="max-w-xl text-lg leading-relaxed text-slate-600">회원가입이 완료되면 장바구니가 자동 생성되고 도서 목록으로 이동합니다.</p>
        </div>

        <div class="rounded-2xl border border-gray-100 bg-white p-8 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.06)]">
            <h2 class="mb-6 text-2xl font-extrabold text-slate-900">회원가입</h2>
            <form class="space-y-5">
                <label class="block">
                    <span class="mb-2 block text-sm font-semibold text-slate-700">아이디</span>
                    <input type="text" id="signupLoginId" class="w-full rounded-lg border border-gray-200 px-4 py-3 outline-none transition focus:border-[#0B1E40] focus:ring-4 focus:ring-slate-100" placeholder="아이디">
                </label>
                <label class="block">
                    <span class="mb-2 block text-sm font-semibold text-slate-700">이름</span>
                    <input type="text" id="signupName" class="w-full rounded-lg border border-gray-200 px-4 py-3 outline-none transition focus:border-[#0B1E40] focus:ring-4 focus:ring-slate-100" placeholder="이름">
                </label>
                <label class="block">
                    <span class="mb-2 block text-sm font-semibold text-slate-700">비밀번호</span>
                    <input type="password" id="signupPassword" class="w-full rounded-lg border border-gray-200 px-4 py-3 outline-none transition focus:border-[#0B1E40] focus:ring-4 focus:ring-slate-100" placeholder="비밀번호">
                </label>
            </form>
            <button type="button" id="btn-signup" class="mt-7 flex w-full items-center justify-center gap-2 rounded-lg bg-[#0B1E40] px-6 py-4 font-semibold text-white transition-colors hover:bg-[#152e5c]">
                <i data-lucide="user-plus" class="h-4 w-4"></i>
                회원가입
            </button>
            <a href="/login" class="mt-4 flex w-full items-center justify-center rounded-lg border border-gray-200 px-6 py-3 font-semibold text-slate-600 transition-colors hover:bg-slate-50">로그인으로 이동</a>
        </div>
    </section>
</main>

{{>layout/footer}}
