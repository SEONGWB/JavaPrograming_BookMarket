{{>layout/header}}

<main class="bg-slate-50 py-16">
    <section class="mx-auto max-w-6xl px-6">
        <div class="mb-8 flex flex-col justify-between gap-4 md:flex-row md:items-end">
            <div>
                <p class="mb-2 text-sm font-bold uppercase tracking-[0.2em] text-emerald-700">Cart</p>
                <h1 class="text-4xl font-extrabold tracking-tight text-[#0B1E40]">장바구니</h1>
                <p class="mt-3 text-sm text-slate-500">회원 ID {{userId}}의 장바구니입니다.</p>
            </div>
            <a href="/books" class="inline-flex items-center justify-center gap-2 rounded-lg border border-[#0B1E40] bg-white px-5 py-3 font-semibold text-[#0B1E40] transition-colors hover:bg-slate-50">
                <i data-lucide="book-open" class="h-4 w-4"></i>
                도서 더 담기
            </a>
        </div>

        {{#cartMessage}}
            <div class="mb-6 rounded-lg border border-amber-200 bg-amber-50 px-5 py-4 text-sm font-medium text-amber-800">{{cartMessage}}</div>
        {{/cartMessage}}

        <div class="grid grid-cols-1 gap-8 lg:grid-cols-[1fr_320px]">
            <div class="overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-[0_4px_20px_-4px_rgba(0,0,0,0.06)]">
                <div class="overflow-x-auto">
                    <table class="w-full min-w-[720px] text-left text-sm">
                        <thead class="bg-slate-900 text-xs uppercase tracking-[0.16em] text-white">
                        <tr>
                            <th class="px-6 py-4">도서명</th>
                            <th class="px-6 py-4 text-right">가격</th>
                            <th class="px-6 py-4 text-center">수량</th>
                            <th class="px-6 py-4 text-right">합계</th>
                            <th class="px-6 py-4 text-center">삭제</th>
                        </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                        {{#cartItems}}
                            <tr class="transition-colors hover:bg-slate-50" data-cart-row data-price="{{price}}" data-quantity="{{quantity}}">
                                <td class="px-6 py-4">
                                    <p class="font-bold text-[#0B1E40]">{{title}}</p>
                                    <p class="mt-1 text-xs text-slate-400">Book ID {{bookId}}</p>
                                </td>
                                <td class="px-6 py-4 text-right font-semibold text-slate-900">{{price}}원</td>
                                <td class="px-6 py-4 text-center">
                                    <input type="number" min="1" value="{{quantity}}" data-cart-item-id="{{cartItemId}}" data-action="cart-quantity" class="w-20 rounded-lg border border-gray-200 px-3 py-2 text-center outline-none focus:border-[#0B1E40] focus:ring-4 focus:ring-slate-100">
                                </td>
                                <td class="px-6 py-4 text-right font-bold text-slate-900" data-line-total></td>
                                <td class="px-6 py-4 text-center">
                                    <button type="button" data-cart-item-id="{{cartItemId}}" data-action="cart-delete" class="inline-flex items-center justify-center rounded-lg bg-red-50 p-2 text-red-600 transition-colors hover:bg-red-100" aria-label="장바구니 삭제">
                                        <i data-lucide="trash-2" class="h-4 w-4"></i>
                                    </button>
                                </td>
                            </tr>
                        {{/cartItems}}
                        {{^cartItems}}
                            <tr>
                                <td colspan="5" class="px-6 py-16 text-center text-slate-500">장바구니에 담긴 도서가 없습니다.</td>
                            </tr>
                        {{/cartItems}}
                        </tbody>
                    </table>
                </div>
            </div>

            <aside class="h-fit rounded-2xl border border-gray-100 bg-white p-6 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.06)]">
                <h2 class="mb-6 text-xl font-extrabold text-slate-900">주문 요약</h2>
                <div class="space-y-4 text-sm">
                    <div class="flex justify-between text-slate-500">
                        <span>상품 금액</span>
                        <strong class="text-slate-900" id="cart-total">{{totalPrice}}원</strong>
                    </div>
                    <div class="flex justify-between text-slate-500">
                        <span>배송비</span>
                        <strong class="text-slate-900">0원</strong>
                    </div>
                </div>
                <div class="my-6 border-t border-gray-100"></div>
                <div class="mb-6 flex justify-between text-lg font-extrabold text-[#0B1E40]">
                    <span>총 결제 금액</span>
                    <span id="cart-grand-total">{{totalPrice}}원</span>
                </div>
                <button type="button" id="btn-order" data-user-id="{{userId}}" class="flex w-full items-center justify-center gap-2 rounded-lg bg-[#0B1E40] px-6 py-4 font-semibold text-white transition-colors hover:bg-[#152e5c]">
                    <i data-lucide="credit-card" class="h-4 w-4"></i>
                    주문하기
                </button>
            </aside>
        </div>
    </section>
</main>

{{>layout/footer}}
