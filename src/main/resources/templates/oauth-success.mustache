{{>layout/header}}

<main class="bg-slate-50 py-16">
    <section class="mx-auto max-w-xl px-6">
        <div class="rounded-2xl border border-gray-100 bg-white p-8 text-center shadow-[0_4px_20px_-4px_rgba(0,0,0,0.06)]">
            <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-full bg-emerald-50 text-emerald-600">
                <i data-lucide="check" class="h-7 w-7"></i>
            </div>
            <h1 class="mb-3 text-3xl font-extrabold text-[#0B1E40]">로그인이 완료되었습니다</h1>
            <p class="mb-8 text-slate-500">잠시 후 도서 목록으로 이동합니다.</p>
            <a href="/books" class="inline-flex items-center justify-center rounded-lg bg-[#0B1E40] px-6 py-3 font-semibold text-white transition-colors hover:bg-[#152e5c]">도서 목록으로 이동</a>
        </div>
    </section>
</main>

<script>
    const params = new URLSearchParams(window.location.search);
    const userId = params.get('userId');
    if (userId) {
        localStorage.setItem('bookmarketUserId', userId);
    }
    setTimeout(function () {
        window.location.href = '/books';
    }, 900);
</script>

{{>layout/footer}}
