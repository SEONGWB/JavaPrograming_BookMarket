{{>layout/header}}

<main class="bg-slate-50 py-16">
    <section class="mx-auto max-w-2xl px-6">
        <div class="rounded-2xl border border-gray-100 bg-white p-8 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.06)]">
            <div class="mb-8">
                <p class="text-sm font-bold uppercase tracking-[0.16em] text-emerald-700">Edit Profile</p>
                <h1 class="mt-2 text-3xl font-extrabold text-[#0B1E40]">개인정보 수정</h1>
            </div>

            <form class="space-y-5">
                <label class="block">
                    <span class="mb-2 block text-sm font-semibold text-slate-700">아이디</span>
                    <input type="text" id="profileEditLoginId" class="w-full rounded-lg border border-gray-200 bg-slate-50 px-4 py-3 text-slate-500 outline-none" readonly>
                </label>
                <label class="block">
                    <span class="mb-2 block text-sm font-semibold text-slate-700">이름</span>
                    <input type="text" id="profileEditName" class="w-full rounded-lg border border-gray-200 px-4 py-3 outline-none transition focus:border-[#0B1E40] focus:ring-4 focus:ring-slate-100" placeholder="이름">
                </label>
                <label class="block">
                    <span class="mb-2 block text-sm font-semibold text-slate-700">새 비밀번호</span>
                    <input type="password" id="profileEditPassword" class="w-full rounded-lg border border-gray-200 px-4 py-3 outline-none transition focus:border-[#0B1E40] focus:ring-4 focus:ring-slate-100" placeholder="변경할 때만 입력">
                </label>
            </form>

            <div class="mt-7 flex flex-col gap-3 sm:flex-row">
                <button type="button" id="btn-user-update" class="inline-flex flex-1 items-center justify-center gap-2 rounded-lg bg-[#0B1E40] px-6 py-4 font-semibold text-white transition-colors hover:bg-[#152e5c]">
                    <i data-lucide="save" class="h-4 w-4"></i>
                    저장
                </button>
                <a href="/user/profile" class="inline-flex flex-1 items-center justify-center rounded-lg border border-gray-200 px-6 py-4 font-semibold text-slate-600 transition-colors hover:bg-slate-50">취소</a>
            </div>
        </div>
    </section>
</main>

{{>layout/footer}}
