{{>layout/header}}

<main class="bg-slate-50 py-16">
    <section class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-6 lg:grid-cols-[1fr_440px] lg:items-center">
        <div>
            <p class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-emerald-700">Login</p>
            <h1 class="mb-5 text-5xl font-extrabold leading-tight tracking-tight text-[#0B1E40]">다시 이어서<br/>책을 담아보세요</h1>
            <p class="max-w-xl text-lg leading-relaxed text-slate-600">일반 로그인 또는 네이버, 구글 OAuth 로그인으로 북마켓을 이용할 수 있습니다.</p>
        </div>

        <div class="rounded-2xl border border-gray-100 bg-white p-8 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.06)]">
            <h2 class="mb-6 text-2xl font-extrabold text-slate-900">로그인</h2>
            <form class="space-y-5">
                <label class="block">
                    <span class="mb-2 block text-sm font-semibold text-slate-700">아이디</span>
                    <input type="text" id="loginId" class="w-full rounded-lg border border-gray-200 px-4 py-3 outline-none transition focus:border-[#0B1E40] focus:ring-4 focus:ring-slate-100" placeholder="아이디">
                </label>
                <label class="block">
                    <span class="mb-2 block text-sm font-semibold text-slate-700">비밀번호</span>
                    <input type="password" id="password" class="w-full rounded-lg border border-gray-200 px-4 py-3 outline-none transition focus:border-[#0B1E40] focus:ring-4 focus:ring-slate-100" placeholder="비밀번호">
                </label>
            </form>
            <button type="button" id="btn-login" class="mt-7 flex w-full items-center justify-center gap-2 rounded-lg bg-[#0B1E40] px-6 py-4 font-semibold text-white transition-colors hover:bg-[#152e5c]">
                <i data-lucide="log-in" class="h-4 w-4"></i>
                로그인
            </button>

            <div class="my-6 flex items-center gap-3">
                <div class="h-px flex-1 bg-gray-100"></div>
                <span class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-400">OAuth</span>
                <div class="h-px flex-1 bg-gray-100"></div>
            </div>

            <div class="grid grid-cols-1 gap-3">
                <a href="/oauth2/authorization/naver" class="flex items-center justify-center gap-3 rounded-lg bg-[#03C75A] px-6 py-3 font-semibold text-white transition-colors hover:bg-[#02b151]">
                    <i data-lucide="message-circle" class="h-4 w-4"></i>
                    네이버로 로그인
                </a>
                <a href="/oauth2/authorization/google" class="flex items-center justify-center gap-3 rounded-lg border border-gray-200 bg-white px-6 py-3 font-semibold text-slate-700 transition-colors hover:bg-slate-50">
                    <i data-lucide="chrome" class="h-4 w-4"></i>
                    구글로 로그인
                </a>
            </div>

            <a href="/signup" class="mt-4 flex w-full items-center justify-center rounded-lg border border-gray-200 px-6 py-3 font-semibold text-slate-600 transition-colors hover:bg-slate-50">회원가입</a>
        </div>
    </section>
</main>

{{>layout/footer}}
