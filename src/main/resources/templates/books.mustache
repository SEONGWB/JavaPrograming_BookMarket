{{>layout/header}}

<main class="bg-slate-50 py-16">
    <section class="mx-auto max-w-7xl px-6">
        <div class="mb-8 flex flex-col justify-between gap-4 md:flex-row md:items-end">
            <div>
                <p class="mb-2 text-sm font-bold uppercase tracking-[0.2em] text-emerald-700">Catalog</p>
                <h1 class="text-4xl font-extrabold tracking-tight text-[#0B1E40]">등록된 도서</h1>
                <p class="mt-3 text-sm text-slate-500">메인 페이지와 분리된 도서 목록 전용 화면입니다.</p>
            </div>
            <a href="/book/save" class="inline-flex items-center justify-center gap-2 rounded-lg bg-[#0B1E40] px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-[#152e5c]">
                <i data-lucide="plus" class="h-4 w-4"></i>
                새 도서 등록
            </a>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
            {{#book}}
                <article class="overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-[0_4px_20px_-4px_rgba(0,0,0,0.06)] transition-shadow hover:shadow-[0_8px_30px_-4px_rgba(0,0,0,0.1)]" data-book-card data-book-id="{{id}}" data-owner-id="{{ownerId}}">
                    <div class="aspect-[4/3] bg-slate-100">
                        {{#imageUrl}}
                            <img src="{{imageUrl}}" alt="{{title}} 표지" class="h-full w-full object-cover">
                        {{/imageUrl}}
                        {{^imageUrl}}
                            <div class="flex h-full w-full items-center justify-center text-slate-300">
                                <i data-lucide="book-image" class="h-16 w-16 stroke-[1.2]"></i>
                            </div>
                        {{/imageUrl}}
                    </div>
                    <div class="p-6">
                        <div class="mb-4 flex items-start justify-between gap-4">
                            <div>
                                <p class="mb-1 text-xs font-bold uppercase tracking-[0.16em] text-emerald-700">{{category}}</p>
                                <h2 class="text-xl font-extrabold text-[#0B1E40]">{{title}}</h2>
                                {{#ownerName}}
                                    <p class="mt-1 text-xs font-semibold text-slate-400">등록자 {{ownerName}}</p>
                                {{/ownerName}}
                            </div>
                            <span class="shrink-0 rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-500">#{{id}}</span>
                        </div>
                        <dl class="space-y-2 text-sm text-slate-600">
                            <div class="flex justify-between gap-4">
                                <dt>저자</dt>
                                <dd class="font-medium text-slate-900">{{author}}</dd>
                            </div>
                            <div class="flex justify-between gap-4">
                                <dt>출판사</dt>
                                <dd class="font-medium text-slate-900">{{publisher}}</dd>
                            </div>
                            <div class="flex justify-between gap-4">
                                <dt>ISBN</dt>
                                <dd class="font-medium text-slate-900">{{isbn}}</dd>
                            </div>
                        </dl>
                        <div class="mt-6 flex items-center justify-between gap-3">
                            <strong class="text-xl font-extrabold text-slate-900">{{price}}원</strong>
                            <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg bg-emerald-600 px-4 py-3 text-sm font-semibold text-white transition-colors hover:bg-emerald-700" data-book-id="{{id}}" data-action="add-cart">
                                <i data-lucide="shopping-cart" class="h-4 w-4"></i>
                                담기
                            </button>
                        </div>
                        <div class="mt-3 hidden grid-cols-2 gap-2" data-owner-actions>
                            <a href="/book/update/{{id}}" class="inline-flex items-center justify-center gap-2 rounded-lg border border-gray-200 px-4 py-2.5 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-50">
                                <i data-lucide="pencil" class="h-4 w-4"></i>
                                수정
                            </a>
                            <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg border border-red-100 px-4 py-2.5 text-sm font-semibold text-red-600 transition-colors hover:bg-red-50" data-book-id="{{id}}" data-action="book-delete">
                                <i data-lucide="trash-2" class="h-4 w-4"></i>
                                삭제
                            </button>
                        </div>
                    </div>
                </article>
            {{/book}}
            {{^book}}
                <div class="col-span-full rounded-2xl border border-gray-100 bg-white px-6 py-16 text-center text-slate-500 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.06)]">
                    등록된 도서가 없습니다.
                </div>
            {{/book}}
        </div>
    </section>
</main>

{{>layout/footer}}
