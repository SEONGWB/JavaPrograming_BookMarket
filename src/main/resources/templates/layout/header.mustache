<!DOCTYPE HTML>
<html lang="ko">
<head>
    <title>북마켓</title>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="min-h-screen bg-white font-sans text-slate-800">
<header class="sticky top-0 z-20 border-b border-gray-100 bg-white/95 backdrop-blur">
    <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-6">
        <a href="/" class="text-2xl font-extrabold tracking-tight text-slate-900">북마켓</a>

        <nav class="hidden items-center gap-8 text-sm font-medium text-slate-600 md:flex">
            <a href="/books" class="flex items-center gap-2 transition-colors hover:text-slate-900">
                <i data-lucide="book" class="h-[18px] w-[18px]"></i>
                도서 목록
            </a>
            <a href="/book/save" class="flex items-center gap-2 transition-colors hover:text-slate-900">
                <i data-lucide="image-plus" class="h-[18px] w-[18px]"></i>
                도서 등록
            </a>
            <a href="/cart/1" class="flex items-center gap-2 transition-colors hover:text-slate-900">
                <i data-lucide="shopping-cart" class="h-[18px] w-[18px]"></i>
                장바구니
            </a>
            <div id="auth-menu" class="relative ml-4">
                <a href="/login" id="auth-link" class="flex items-center gap-2 transition-colors hover:text-slate-900">
                    <i data-lucide="user" class="h-[18px] w-[18px]"></i>
                    로그인
                </a>
            </div>
        </nav>

        <button type="button" class="rounded-lg p-2 text-slate-600 hover:bg-slate-100 md:hidden" aria-label="메뉴">
            <i data-lucide="menu" class="h-6 w-6"></i>
        </button>
    </div>
</header>
